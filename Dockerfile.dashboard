FROM python:3.12-slim

WORKDIR /app

RUN useradd --create-home appuser

COPY src ./src
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir .

COPY apps ./apps
COPY data/fixtures ./data/fixtures
COPY scripts ./scripts

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 10000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.getenv('PORT', '10000') + '/_stcore/health', timeout=4)"

CMD ["sh", "-c", "python scripts/prepare_data.py && streamlit run apps/streamlit_app/app.py --server.address 0.0.0.0 --server.port ${PORT:-10000}"]
